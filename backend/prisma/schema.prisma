generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Purchase {
  id             String   @id @default(uuid())
  materialName   String   @db.VarChar(200)
  supplier       String?  @db.VarChar(200)
  purchaseDate   DateTime @db.Date
  unitOfMeasure  String   @default("PCS")
  quantity       Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(14, 2)
  additionalCost Decimal  @default(0) @db.Decimal(14, 2)
  totalCost      Decimal  @db.Decimal(24, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([purchaseDate, createdAt])
  @@map("purchases")
}

enum CustomerType {
  INDIVIDUAL
  ORGANIZATION
}

model Customer {
  id           String       @id @default(uuid())
  customerType CustomerType @default(ORGANIZATION)
  name         String
  companyName  String?
  taxId        String?
  email        String?      @unique
  phone        String?
  address      String?
  city         String?
  notes        String?
  quotations   Quotation[]
  saleOrders   SaleOrder[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("customers")
}

model ProductSku {
  id            String          @id @default(uuid())
  skuCode       String          @unique
  name          String
  glassType     String
  thicknessMm   Decimal
  unitOfMeasure String          @default("SQ_METER")
  unitPrice     Decimal
  description   String?
  quoteItems    QuotationItem[]
  saleItems     SaleOrderItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("product_skus")
}

model Quotation {
  id             String             @id @default(uuid())
  quoteNumber    String             @unique
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  status         String             @default("DRAFT")
  issueDate      DateTime           @default(now())
  validUntil     DateTime?
  subtotal       Decimal            @default(0)
  discountType   String             @default("PERCENTAGE")
  discountValue  Decimal            @default(0)
  discountAmount Decimal            @default(0)
  taxRate        Decimal            @default(0)
  taxAmount      Decimal            @default(0)
  totalAmount    Decimal            @default(0)
  notes          String?
  sections       QuotationSection[]
  saleOrders     SaleOrder[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("quotations")
}

model QuotationSection {
  id          String          @id @default(uuid())
  quotationId String
  quotation   Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  sectionName String
  sortOrder   Int             @default(0)
  items       QuotationItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("quotation_sections")
}

model QuotationItem {
  id                  String           @id @default(uuid())
  sectionId           String
  section             QuotationSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productSkuId        String
  productSku          ProductSku       @relation(fields: [productSkuId], references: [id])
  description         String?
  widthMm             Decimal?
  heightMm            Decimal?
  widthInches         Decimal?
  heightInches        Decimal?
  roundedWidthInches  Decimal?
  roundedHeightInches Decimal?
  quantity            Decimal          @default(1)
  areaSqM             Decimal?
  areaSqFt            Decimal?
  unitPrice           Decimal
  totalPrice          Decimal
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("quotation_items")
}

model SaleOrder {
  id              String          @id @default(uuid())
  orderNumber     String          @unique
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  quotationId     String?
  quotation       Quotation?      @relation(fields: [quotationId], references: [id])
  status          String          @default("PENDING")
  paymentStatus   String          @default("UNPAID")
  paymentMode     String          @default("CASH")
  orderDate       DateTime        @default(now())
  deliveryAddress String?
  subtotal        Decimal?
  discountType    String?         @default("PERCENTAGE")
  discountValue   Decimal?        @default(0)
  discountAmount  Decimal?        @default(0)
  taxRate         Decimal?        @default(0)
  taxAmount       Decimal?        @default(0)
  totalAmount     Decimal         @default(0)
  isLocked        Boolean         @default(false)
  items           SaleOrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("sale_orders")
}

model SaleOrderItem {
  id           String      @id @default(uuid())
  saleOrderId  String
  saleOrder    SaleOrder   @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  sectionName  String?
  productSkuId String?
  productSku   ProductSku? @relation(fields: [productSkuId], references: [id])
  description  String?
  widthMm      Decimal?
  heightMm     Decimal?
  widthInches  Decimal?
  heightInches Decimal?
  areaSqFt     Decimal?
  quantity     Decimal     @default(1)
  unitPrice    Decimal
  totalPrice   Decimal
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("sale_order_items")
}

model Employee {
  id           String           @id @default(uuid())
  employeeCode String           @unique @db.VarChar(40)
  name         String           @db.VarChar(120)
  role         String           @db.VarChar(120)
  phone        String?          @db.VarChar(40)
  address      String?          @db.VarChar(500)
  joinedOn     DateTime         @db.Date
  leftOn       DateTime?        @db.Date
  salaries     EmployeeSalary[]
  payroll      PayrollEntry[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("employees")
}

model EmployeeSalary {
  employeeId  String
  effectiveOn DateTime @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@id([employeeId, effectiveOn])
  @@map("employee_salaries")
}

model PayrollRun {
  month     String         @id @db.VarChar(7)
  entries   PayrollEntry[]
  createdAt DateTime       @default(now())

  @@map("payroll_runs")
}

model PayrollEntry {
  month         String     @db.VarChar(7)
  employeeId    String
  employeeCode  String     @db.VarChar(40)
  name          String     @db.VarChar(120)
  eligibleDays  Int
  unpaidDays    Int
  paidDays      Int
  basePay       Decimal    @db.Decimal(12, 2)
  additions     Decimal    @db.Decimal(12, 2)
  deductions    Decimal    @db.Decimal(12, 2)
  grossPay      Decimal    @db.Decimal(13, 2)
  netPay        Decimal    @db.Decimal(13, 2)
  run           PayrollRun @relation(fields: [month], references: [month])
  employee      Employee   @relation(fields: [employeeId], references: [id])

  @@id([month, employeeId])
  @@index([employeeId])
  @@map("payroll_entries")
}
