{
  "name": "glass-erp-backend",
  "version": "1.0.0",
  "description": "Glass ERP Backend API",
  "main": "src/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "prestart": "prisma generate",
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:reset": "node scripts/reset-db.js",
    "db:seed": "node prisma/seed-demo.js",
    "test": "node src/services/glassCalculations.service.test.js && node --test src/controllers/purchases.test.js src/controllers/inventory.test.js src/services/payroll.service.test.js src/services/ledger.service.test.js src/controllers/ledger.test.js && node prisma/seed-demo.test.js"
  },
  "prisma": {
    "seed": "node prisma/seed-demo.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "prisma": "^6.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
