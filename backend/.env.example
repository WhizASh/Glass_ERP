PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection Pooler (Transaction mode, port 6543)
# Replace 'yourprojectref' and 'yourpassword' with your Supabase credentials
DATABASE_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Session mode, port 5432 - required for migrations)
DIRECT_URL="postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Frontend Client URL for CORS
CLIENT_URL="http://localhost:5173"
